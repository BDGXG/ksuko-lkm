#!/system/bin/sh
# CGI：/cgi-bin/api?action=xxx  ->  dim CLI
export PATH=/data/adb/ksu/bin:/system/bin:/system/xbin:/vendor/bin:$PATH
MODDIR=/data/adb/modules/dim
[ -d "$MODDIR" ] || MODDIR=/data/adb/modules_update/dim
DIM="$MODDIR/bin/dim"

Q="${QUERY_STRING:-}"
ACT="${Q#action=}"
ACT="${ACT%%&*}"
VAL=""
case "$Q" in
  *value=*) VAL="${Q#*value=}"; VAL="${VAL%%&*}" ;;
esac
# URL 解码：先把反斜杠转义一层，避免值里的 \ 被 printf %b 当成转义序列
urldecode() {
  _u=$(printf '%s' "$1" | sed 's/\\/\\\\/g')
  printf '%b' "${_u//%/\\x}" 2>/dev/null | tr '+' ' '
}
ACT=$(urldecode "$ACT")
VAL=$(urldecode "$VAL")

case "$ACT" in
  status|apply|randomize|restore|log|drm-info|drm-off|drm|drm-stats|setmaster|serial-restore|drmid-rand|oaid|appset|baseline)
       OUT=$(sh "$DIM" "$ACT") ;;
  serial|ssaid|drmid|uids|haluid|conf|opt-stop|opt-qimei|opt-drmstop|ssaidpkgs|drmpkgs|ssaid-restore)
       OUT=$(sh "$DIM" "$ACT" "$VAL") ;;
  apps)  OUT=$(sh "$MODDIR/bin/icons.sh" >/dev/null 2>&1; cat /data/adb/dim/apps.json 2>/dev/null) ;;
  apps-cached) OUT=$(cat /data/adb/dim/apps.json 2>/dev/null) ;;
  apps-fast)   [ -s /data/adb/dim/apps.json ] || sh "$MODDIR/bin/apps.sh" >/dev/null 2>&1
               OUT=$(cat /data/adb/dim/apps.json 2>/dev/null) ;;
  *)   OUT='{"ok":false,"error":"unknown action"}' ;;
esac
[ -n "$OUT" ] || OUT='{"ok":false,"error":"empty"}'

printf 'Content-Type: application/json; charset=utf-8\r\n'
printf 'Cache-Control: no-store\r\n'
printf 'X-Content-Type-Options: nosniff\r\n'
# CORS：只对 KSU WebUI / 本机来源回显 Origin。
# KSU 模块卡片打开面板时页面来源是 https://mui.kernelsu.org，
# 请求 127.0.0.1:16667 属于跨域，没有 ACAO 会被浏览器拦掉（面板卡在“检测中”）。
# 其他站点拿不到 ACAO，浏览器不会放行读取响应。
_o="${HTTP_ORIGIN:-}"
case "$_o" in
  https://mui.kernelsu.org*|http://mui.kernelsu.org*|https://kernelsu.org*)
    printf 'Access-Control-Allow-Origin: %s\r\n' "$_o"
    printf 'Vary: Origin\r\n' ;;
esac
printf '\r\n'
printf '%s' "$OUT"